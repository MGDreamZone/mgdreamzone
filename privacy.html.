  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Privacy Policy | MG DREAM ZONE</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --pink: #c76c91;
      --pink-dark: #a74f73;
      --pink-soft: #f9edf3;
      --cream: #fffdfc;
      --black: #292329;
      --gray: #686168;
      --border: #eadde3;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: "DM Sans", sans-serif;
      background: var(--cream);
      color: var(--black);
      line-height: 1.8;
    }

    header {
      background: var(--black);
      padding: 22px 20px;
      text-align: center;
    }

    .logo {
      color: white;
      font-family: "Playfair Display", serif;
      font-size: 28px;
      font-weight: 700;
      letter-spacing: 2px;
      text-decoration: none;
    }

    .subtitle {
      color: #e8cfd9;
      font-size: 12px;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-top: 4px;
    }

    .hero {
      background: var(--pink-soft);
      text-align: center;
      padding: 55px 20px;
      border-bottom: 1px solid var(--border);
    }

    .hero h1 {
      font-family: "Playfair Display", serif;
      font-size: 42px;
      margin-bottom: 10px;
    }

    .hero p {
      color: var(--gray);
      font-size: 14px;
    }

    .container {
      width: min(900px, 92%);
      margin: 45px auto 70px;
    }

    .intro {
      background: white;
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 25px;
      margin-bottom: 32px;
    }

    section {
      margin-bottom: 35px;
    }

    h2 {
      font-family: "Playfair Display", serif;
      font-size: 25px;
      color: var(--pink-dark);
      margin-bottom: 12px;
    }

    p {
      margin-bottom: 12px;
      color: #4f494f;
      font-size: 15px;
    }

    ul {
      padding-left: 25px;
      color: #4f494f;
      font-size: 15px;
    }

    li {
      margin-bottom: 8px;
    }

    .back {
      display: inline-block;
      margin-top: 5px;
      padding: 11px 22px;
      background: var(--pink);
      color: white;
      text-decoration: none;
      border-radius: 25px;
      font-size: 14px;
      font-weight: 600;
    }

    .back:hover {
      background: var(--pink-dark);
    }

    footer {
      background: var(--black);
      color: #ddd;
      text-align: center;
      padding: 28px 20px;
      font-size: 13px;
    }

    footer a {
      color: #e8a9c3;
      text-decoration: none;
      margin: 0 8px;
    }

    footer a:hover {
      text-decoration: underline;
    }

    @media (max-width: 600px) {
      .hero h1 {
        font-size: 32px;
      }

      h2 {
        font-size: 22px;
      }
    }
  </style>
</head>

<body>

  <header>
    <a href="index.html" class="logo">MG DREAM ZONE</a>
